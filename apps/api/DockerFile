# Gunakan Node.js LTS berbasis Alpine yang ringan
FROM node:20-alpine

# Set folder kerja di dalam container
WORKDIR /app

# Copy file package.json dan package-lock.json (jika ada)
COPY package*.json ./

# Install seluruh dependencies (termasuk devDependencies karena butuh typescript untuk build)
RUN npm install

# Copy seluruh kodingan dari apps/api ke dalam container
COPY . .

# Generate Prisma Client dan Compile TypeScript ke JavaScript (dist/)
RUN npm run build

# Buka port 7860 sesuai regulasi wajib Hugging Face Spaces
EXPOSE 7860

# Set Environment Variables default untuk container
ENV API_PORT=7860
ENV NODE_ENV=production

# Jalankan langsung file hasil compile JS agar efisien
CMD ["node", "dist/server.js"]