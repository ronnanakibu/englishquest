{
  "name": "englishquest",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm run db:generate && tsc",
    "start": "node dist/index.js",
    "db:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "framer-motion": "^12.38.0",
    "zustand": "^5.0.13",
    "typescript": "^5.4.5",
    "tsx": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0"
  }
}
